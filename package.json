{
  "name": "homileo",
  "version": "0.1.0",
  "description": "A generic chat service for apps built on tereo — spaces, sessions, messages, threads, reactions, mentions, read state, attachments, presence, search and realtime delivery, extended through provisioning documents",
  "author": "Aaron Leman",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "23.3.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^25.9.9",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "nx": "23.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "ioredis": "^6.0.0",
    "nx": {
      "undici": "^7.29.1"
    },
    "prisma": {
      "mysql2": "^3.24.6"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  },
  "engines": {
    "node": "22.x.x"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false
  },
  "scripts": {
    "format": "prettier --write --no-error-on-unmatched-pattern \"packages/*/src/**/*.{ts,tsx,js,jsx,css}\" scripts",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"packages/*/src/**/*.{ts,tsx,js,jsx,css}\" scripts",
    "lint": "eslint --no-error-on-unmatched-pattern packages/ scripts/ && { ls packages/*/package.json >/dev/null 2>&1 || exit 0; npm run lint --workspaces --if-present; }",
    "sort-imports": "tsx scripts/sort-imports.ts",
    "sort-imports:check": "tsx scripts/sort-imports.ts --check",
    "check": "nx run-many -t check",
    "version-plan": "nx release plan"
  }
}
