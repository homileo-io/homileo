# Copy to .env for `npm run dev` and local test runs.

# Matches docker-compose.yml's postgres/redis on their host ports.
DATABASE_URL=postgresql://homileo:homileo@localhost:5452/homileo
REDIS_URL=redis://localhost:6399
PUBLIC_URL=http://localhost:4101

# Local runs skip the tereo connection and accept SDK test tokens. Refused in
# production, where TEREO_URL, TEREO_CLIENT_ID, TEREO_CLIENT_SECRET and
# REQUEST_HANDLER_KEY are required instead.
TEREO_TEST_MODE=true

# Database limits (defaults shown). A transaction that cannot start or runs
# out of time, or a lock wait past DB_LOCK_TIMEOUT_MS (which must stay below
# DB_TRANSACTION_TIMEOUT_MS), answers 503 temporarily_unavailable.
# DB_POOL_MAX=10
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_TRANSACTION_MAX_WAIT_MS=5000
# DB_TRANSACTION_TIMEOUT_MS=10000
# DB_LOCK_TIMEOUT_MS=5000
