{
  "version": "0.0.0",
  "service": {
    "slug": "homileo",
    "name": "Homileo",
    "secretFrom": "TEREO_CLIENT_SECRET",
    "access": {
      "roles": [
        "audit_writer",
        "webhook_publisher",
        "notification_sender"
      ]
    },
    "permissions": [
      {
        "name": "homileo.spaces.read",
        "displayName": "Read spaces",
        "description": "Use the chat API and realtime: read spaces, sessions and messages, keep one's own read state, and receive their webhook events",
        "orgAssignable": true
      },
      {
        "name": "homileo.spaces.write",
        "displayName": "Use spaces",
        "description": "Create and change spaces, sessions and their members; post, edit and react to messages",
        "orgAssignable": true
      },
      {
        "name": "homileo.messages.read_private",
        "displayName": "Receive private messages",
        "description": "Receive webhook events of DMs, space-less groups and members-only sessions, message bodies included",
        "orgAssignable": true
      },
      {
        "name": "homileo.chat.admin",
        "displayName": "Administer chat",
        "description": "Administer every space and session of the organization, without reading its DMs; also grants Read spaces and Use spaces",
        "orgAssignable": true
      }
    ],
    "systemRoles": [
      {
        "name": "homileo_user",
        "displayName": "Homileo user",
        "description": "Takes part in chat",
        "permissions": [
          "homileo.spaces.write"
        ]
      }
    ],
    "buckets": [
      {
        "bucketName": "homileo-attachments",
        "description": "Message attachments",
        "policy": "private"
      }
    ],
    "eventTypes": [
      {
        "eventType": "homileo.space.created",
        "description": "homileo.space.created",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.space.updated",
        "description": "homileo.space.updated",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.space.archived",
        "description": "homileo.space.archived",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.space.member_added",
        "description": "homileo.space.member_added",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.space.member_removed",
        "description": "homileo.space.member_removed",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.space.member_role_changed",
        "description": "homileo.space.member_role_changed",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.space.join_requested",
        "description": "homileo.space.join_requested",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.space.join_decided",
        "description": "homileo.space.join_decided",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.session.created",
        "description": "homileo.session.created",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.session.updated",
        "description": "homileo.session.updated",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.session.archived",
        "description": "homileo.session.archived",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.session.participant_added",
        "description": "homileo.session.participant_added",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.session.participant_removed",
        "description": "homileo.session.participant_removed",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.message.created",
        "description": "homileo.message.created",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.message.edited",
        "description": "homileo.message.edited",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.message.deleted",
        "description": "homileo.message.deleted",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.reaction.added",
        "description": "homileo.reaction.added",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.reaction.removed",
        "description": "homileo.reaction.removed",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.thread.updated",
        "description": "homileo.thread.updated",
        "readPermission": "homileo.spaces.read"
      },
      {
        "eventType": "homileo.private_session.created",
        "description": "homileo.private_session.created",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_session.updated",
        "description": "homileo.private_session.updated",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_session.archived",
        "description": "homileo.private_session.archived",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_session.participant_added",
        "description": "homileo.private_session.participant_added",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_session.participant_removed",
        "description": "homileo.private_session.participant_removed",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_message.created",
        "description": "homileo.private_message.created",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_message.edited",
        "description": "homileo.private_message.edited",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_message.deleted",
        "description": "homileo.private_message.deleted",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_reaction.added",
        "description": "homileo.private_reaction.added",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_reaction.removed",
        "description": "homileo.private_reaction.removed",
        "readPermission": "homileo.messages.read_private"
      },
      {
        "eventType": "homileo.private_thread.updated",
        "description": "homileo.private_thread.updated",
        "readPermission": "homileo.messages.read_private"
      }
    ]
  }
}
