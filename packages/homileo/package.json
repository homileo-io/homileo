{
  "name": "homileo",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "../../docker/test/run.sh",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:local": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:logs": "../../docker/test/run.sh logs -f runner",
    "test:clean": "../../docker/test/run.sh down -v",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
