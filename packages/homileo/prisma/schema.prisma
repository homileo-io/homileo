// One schema for all of Homileo. `chat` holds the chat data; `core` holds the
// tereo SDK's outbox.
//
// Migrations are generated by `prisma migrate dev --create-only`. Features
// Prisma cannot express — range partitioning, partial indexes, CHECK
// constraints — are appended as raw SQL to the generated migration.
// Search columns and their indexes are added by a later migration.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["chat", "core"]
}

// ===========================================================================
// enums
// ===========================================================================

enum PrincipalKind {
  user
  external

  @@map("principal_kind")
  @@schema("chat")
}

enum SpaceVisibility {
  public
  members

  @@map("space_visibility")
  @@schema("chat")
}

enum JoinPolicy {
  open
  request
  invite

  @@map("join_policy")
  @@schema("chat")
}

enum PostPolicy {
  members
  moderators

  @@map("post_policy")
  @@schema("chat")
}

enum SpaceRole {
  owner
  moderator
  member

  @@map("space_role")
  @@schema("chat")
}

enum SessionType {
  direct
  group

  @@map("session_type")
  @@schema("chat")
}

enum SessionAccess {
  space
  members

  @@map("session_access")
  @@schema("chat")
}

enum ParticipantRole {
  owner
  member

  @@map("participant_role")
  @@schema("chat")
}

enum NotifyLevel {
  all
  mentions
  none

  @@map("notify_level")
  @@schema("chat")
}

enum JoinRequestStatus {
  pending
  approved
  denied

  @@map("join_request_status")
  @@schema("chat")
}

enum MentionKind {
  user
  here
  session

  @@map("mention_kind")
  @@schema("chat")
}

// ===========================================================================
// principals
// ===========================================================================

model Principal {
  id          String        @id @default(uuid(7)) @db.Uuid
  kind        PrincipalKind
  tereoUserId String?       @unique @map("tereo_user_id") @db.Uuid
  app         String?       @db.VarChar(100)
  externalId  String?       @map("external_id") @db.VarChar(255)
  isBot       Boolean       @default(false) @map("is_bot")
  displayName String?       @map("display_name") @db.VarChar(255)
  avatarUrl   String?       @map("avatar_url") @db.VarChar(2048)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)

  spacesCreated         Space[]              @relation("SpaceCreatedBy")
  spaceMemberships      SpaceMember[]
  joinRequests          SpaceJoinRequest[]   @relation("JoinRequestUser")
  joinRequestsDecided   SpaceJoinRequest[]   @relation("JoinRequestDecidedBy")
  sessionsCreated       Session[]            @relation("SessionCreatedBy")
  sessionParticipations SessionParticipant[]
  messagesSent          Message[]            @relation("MessageSender")
  messagesDeleted       Message[]            @relation("MessageDeletedBy")
  revisionsEdited       MessageRevision[]
  mentions              MessageMention[]
  reactions             Reaction[]
  threadFollows         ThreadFollower[]
  events                Event[]

  @@unique([app, externalId])
  @@map("principals")
  @@schema("chat")
}

// ===========================================================================
// spaces
// ===========================================================================

model Space {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  kind           String          @db.VarChar(64)
  name           String          @db.VarChar(255)
  description    String?
  visibility     SpaceVisibility @default(members)
  joinPolicy     JoinPolicy      @default(invite) @map("join_policy")
  postPolicy     PostPolicy      @default(members) @map("post_policy")
  state          String?         @db.VarChar(64)
  externalRef    String?         @map("external_ref") @db.VarChar(255)
  metadata       Json            @default("{}")
  createdBy      String          @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamp(3)
  archivedAt     DateTime?       @map("archived_at") @db.Timestamp(3)

  creator      Principal          @relation("SpaceCreatedBy", fields: [createdBy], references: [id])
  members      SpaceMember[]
  joinRequests SpaceJoinRequest[]
  sessions     Session[]

  @@unique([organizationId, kind, externalRef])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("spaces")
  @@schema("chat")
}

model SpaceMember {
  spaceId  String    @map("space_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     SpaceRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamp(3)

  space Space     @relation(fields: [spaceId], references: [id])
  user  Principal @relation(fields: [userId], references: [id])

  @@id([spaceId, userId])
  @@index([userId])
  @@map("space_members")
  @@schema("chat")
}

model SpaceJoinRequest {
  id        String            @id @default(uuid(7)) @db.Uuid
  spaceId   String            @map("space_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  status    JoinRequestStatus @default(pending)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  decidedBy String?           @map("decided_by") @db.Uuid
  decidedAt DateTime?         @map("decided_at") @db.Timestamp(3)

  space   Space      @relation(fields: [spaceId], references: [id])
  user    Principal  @relation("JoinRequestUser", fields: [userId], references: [id])
  decider Principal? @relation("JoinRequestDecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([spaceId, status])
  @@map("space_join_requests")
  @@schema("chat")
}

// ===========================================================================
// sessions
// ===========================================================================

model Session {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  spaceId        String?       @map("space_id") @db.Uuid
  type           SessionType
  access         SessionAccess @default(space)
  name           String?       @db.VarChar(255)
  state          String?       @db.VarChar(64)
  lastSeq        BigInt        @default(0) @map("last_seq")
  lastMessageAt  DateTime?     @map("last_message_at") @db.Timestamp(3)
  directKey      String?       @map("direct_key") @db.VarChar(80)
  externalRef    String?       @map("external_ref") @db.VarChar(255)
  metadata       Json          @default("{}")
  createdBy      String        @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamp(3)

  // Composite, so a session's organization is its space's.
  space        Space?               @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  creator      Principal            @relation("SessionCreatedBy", fields: [createdBy], references: [id])
  participants SessionParticipant[]
  messages     Message[]
  mentions     MessageMention[]

  @@index([organizationId, spaceId])
  @@index([externalRef])
  @@index([metadata], type: Gin)
  @@map("sessions")
  @@schema("chat")
}

model SessionParticipant {
  sessionId   String          @map("session_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  role        ParticipantRole @default(member)
  lastReadSeq BigInt          @default(0) @map("last_read_seq")
  notify      NotifyLevel     @default(all)
  joinedAt    DateTime        @default(now()) @map("joined_at") @db.Timestamp(3)
  leftAt      DateTime?       @map("left_at") @db.Timestamp(3)

  session Session   @relation(fields: [sessionId], references: [id])
  user    Principal @relation(fields: [userId], references: [id])

  @@id([sessionId, userId])
  @@index([userId])
  @@map("session_participants")
  @@schema("chat")
}

// ===========================================================================
// messages
// ===========================================================================

model Message {
  id              String    @id @default(uuid(7)) @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  seq             BigInt
  senderId        String    @map("sender_id") @db.Uuid
  clientMessageId String    @map("client_message_id") @db.VarChar(128)
  type            String    @default("text") @db.VarChar(64)
  body            String?
  bodyText        String?   @map("body_text")
  payload         Json?
  metadata        Json      @default("{}")
  threadRootId    String?   @map("thread_root_id") @db.Uuid
  replyCount      Int       @default(0) @map("reply_count")
  lastReplyAt     DateTime? @map("last_reply_at") @db.Timestamp(3)
  revision        Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  editedAt        DateTime? @map("edited_at") @db.Timestamp(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamp(3)
  deletedBy       String?   @map("deleted_by") @db.Uuid

  session     Session           @relation(fields: [sessionId], references: [id])
  sender      Principal         @relation("MessageSender", fields: [senderId], references: [id])
  deleter     Principal?        @relation("MessageDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)
  threadRoot  Message?          @relation("Thread", fields: [threadRootId], references: [id], onDelete: Restrict)
  replies     Message[]         @relation("Thread")
  revisions   MessageRevision[]
  mentions    MessageMention[]
  reactions   Reaction[]
  attachments Attachment[]
  followers   ThreadFollower[]

  @@unique([sessionId, seq])
  @@unique([sessionId, senderId, clientMessageId])
  @@index([threadRootId, seq])
  @@map("messages")
  @@schema("chat")
}

model MessageRevision {
  messageId String   @map("message_id") @db.Uuid
  revision  Int
  body      String?
  payload   Json?
  editedBy  String   @map("edited_by") @db.Uuid
  editedAt  DateTime @default(now()) @map("edited_at") @db.Timestamp(3)

  message Message   @relation(fields: [messageId], references: [id])
  editor  Principal @relation(fields: [editedBy], references: [id])

  @@id([messageId, revision])
  @@map("message_revisions")
  @@schema("chat")
}

// The spec lists no key for this table; the surrogate id gives Prisma one.
model MessageMention {
  id        BigInt      @id @default(autoincrement())
  messageId String      @map("message_id") @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  kind      MentionKind
  userId    String?     @map("user_id") @db.Uuid

  message Message    @relation(fields: [messageId], references: [id])
  session Session    @relation(fields: [sessionId], references: [id])
  user    Principal? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([userId, messageId])
  @@map("message_mentions")
  @@schema("chat")
}

model Reaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  message Message   @relation(fields: [messageId], references: [id])
  user    Principal @relation(fields: [userId], references: [id])

  @@id([messageId, userId, emoji])
  @@map("reactions")
  @@schema("chat")
}

model Attachment {
  id            String @id @default(uuid(7)) @db.Uuid
  messageId     String @map("message_id") @db.Uuid
  tereoObjectId String @map("tereo_object_id") @db.VarChar(255)
  filename      String @db.VarChar(255)
  contentType   String @map("content_type") @db.VarChar(255)
  size          BigInt
  position      Int    @default(0)

  message Message @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("attachments")
  @@schema("chat")
}

model ThreadFollower {
  threadRootId String  @map("thread_root_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  lastReadSeq  BigInt  @default(0) @map("last_read_seq")
  following    Boolean @default(true)

  threadRoot Message   @relation(fields: [threadRootId], references: [id])
  user       Principal @relation(fields: [userId], references: [id])

  @@id([threadRootId, userId])
  @@map("thread_followers")
  @@schema("chat")
}

// ===========================================================================
// events
// ===========================================================================

// Range-partitioned by day on created_at (raw SQL in the baseline migration).
// A partitioned table's primary key must include the partition column.
model Event {
  id             BigInt   @default(autoincrement())
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  type           String   @db.VarChar(100)
  organizationId String   @map("organization_id") @db.Uuid
  spaceId        String?  @map("space_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  payload        Json

  actor Principal? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@id([id, createdAt])
  @@index([organizationId, id])
  @@index([sessionId, id])
  @@map("events")
  @@schema("chat")
}

// ===========================================================================
// provisioned registries (written only by provisioning)
// ===========================================================================

model ProvisionedSpaceKind {
  name            String    @id @db.VarChar(64)
  app             String    @db.VarChar(100)
  definition      Json
  documentVersion String    @db.VarChar(64) @map("document_version")
  sourceFile      String    @map("source_file") @db.VarChar(512)
  retiredAt       DateTime? @map("retired_at") @db.Timestamp(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("provisioned_space_kinds")
  @@schema("chat")
}

model ProvisionedMessageType {
  name            String    @id @db.VarChar(64)
  app             String    @db.VarChar(100)
  payloadSchema   Json      @map("payload_schema")
  documentVersion String    @db.VarChar(64) @map("document_version")
  sourceFile      String    @map("source_file") @db.VarChar(512)
  retiredAt       DateTime? @map("retired_at") @db.Timestamp(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("provisioned_message_types")
  @@schema("chat")
}

// ===========================================================================
// core
// ===========================================================================

// The @tereo-io/sdk outbox (docs/outbox.md). The reaper's SQL is hard-coded to
// these columns: do not rename them.
model CoreOutbox {
  id             String    @id @db.Uuid
  destination    String    @db.VarChar(64)
  payload        Json
  traceparent    String?   @db.VarChar(64)
  tracestate     String?   @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  claimedAt      DateTime? @map("claimed_at")
  claimedBy      String?   @map("claimed_by") @db.VarChar(255)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  deadLetteredAt DateTime? @map("dead_lettered_at")

  @@index([nextAttemptAt])
  @@map("core_outbox")
  @@schema("core")
}
