{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "app": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "spaceKinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9_-]*$"
          },
          "defaults": {
            "type": "object",
            "properties": {
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "members"
                ]
              },
              "join": {
                "type": "string",
                "enum": [
                  "open",
                  "request",
                  "invite"
                ]
              },
              "posting": {
                "type": "string",
                "enum": [
                  "members",
                  "moderators"
                ]
              }
            },
            "required": [
              "visibility",
              "join",
              "posting"
            ],
            "additionalProperties": false
          },
          "overridable": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "visibility",
                "join",
                "posting"
              ]
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$"
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "permission": {
                  "type": "string",
                  "minLength": 1
                },
                "access": {
                  "type": "string",
                  "enum": [
                    "read",
                    "moderate"
                  ]
                }
              },
              "required": [
                "permission",
                "access"
              ],
              "additionalProperties": false
            }
          },
          "bots": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "editWindowSeconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "search": {
            "type": "object",
            "properties": {
              "metadata": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            "required": [
              "metadata"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "defaults"
        ],
        "additionalProperties": false
      }
    },
    "messageTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9_-]*$"
          },
          "payloadSchema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name",
          "payloadSchema"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "app"
  ],
  "additionalProperties": false
}
