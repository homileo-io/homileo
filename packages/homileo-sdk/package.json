{
  "name": "@homileo-io/sdk",
  "version": "0.0.0",
  "type": "module",
  "description": "The contract of Homileo: its event registry and provisioning document types",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/tests",
    "!src/tests",
    "provisioning.schema.json",
    "!**/*.tsbuildinfo",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "provisioning:schema": "tsc && node scripts/provisioningSchema.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Aaron Leman",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homileo-io/homileo.git",
    "directory": "packages/homileo-sdk"
  },
  "homepage": "https://github.com/homileo-io/homileo/tree/master/packages/homileo-sdk#readme",
  "bugs": {
    "url": "https://github.com/homileo-io/homileo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "ajv": "^8.17.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
